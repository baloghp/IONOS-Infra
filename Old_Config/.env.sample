# Database Configuration
# PostgreSQL user for N8N database
POSTGRES_USER=your_postgres_user
# PostgreSQL password for N8N database
POSTGRES_PASSWORD=your_secure_password
# PostgreSQL database name for N8N
POSTGRES_DB=your_database_name

# OpenRouter Configuration
# Your OpenRouter API key for accessing AI models
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# WebUI Configuration
# Secret key for OpenWebUI session encryption and security
# Generate a secure random string
WEBUI_SECRET_KEY=your_webui_secret_key

# N8N Configuration
# Database name for N8N
N8N_DB_NAME=n8n
# Hostname for N8N instance
N8N_HOST=your.domain.com
# Protocol for N8N (http or https)
N8N_PROTOCOL=https
# Basic authentication username for N8N
N8N_BASIC_AUTH_USER=admin
# Basic authentication password for N8N
N8N_BASIC_AUTH_PASSWORD=your_secure_password

# Gmail SMTP Configuration for N8N
# Gmail SMTP server
N8N_SMTP_HOST=smtp.gmail.com
# Gmail SMTP port (587 for TLS)
N8N_SMTP_PORT=587
# Your Gmail address
N8N_SMTP_USER=your.email@gmail.com
# Gmail App Password (not your regular password)
# Generate from: https://myaccount.google.com/apppasswords
N8N_SMTP_PASS=your_app_password
# Email sender address
N8N_SMTP_SENDER=your.email@gmail.com
# Email reply-to address
N8N_SMTP_REPLY_TO=your.email@gmail.com 