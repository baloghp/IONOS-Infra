# Ansible-managed — AIACC (Next.js, gateway Docker network)
services:
  aiacc:
    image: {{ aiacc_image }}
    container_name: aiacc
    restart: unless-stopped
    env_file:
      - {{ aiacc_env_file }}
    networks:
      - {{ aiacc_docker_network }}
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1:{{ aiacc_container_port }}/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 45s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  {{ aiacc_docker_network }}:
    external: true
