#!/usr/bin/env bash
# Write Caddy basic-auth snippet for www.ittd.app from OpenBao prod/www
set -euo pipefail

AUTH_FILE="{{ caddy_www_gateway_auth_file }}"
BAO_ADDR="${BAO_ADDR:-http://{{ wireguard_hosts['ts-ionos-infra'].wg_ip }}:8200}"
CADDY_IMAGE="{{ caddy_image }}"

if [[ -z "${BAO_TOKEN:-}" ]]; then
  echo "ERROR: export BAO_TOKEN=<token> then: sudo -E $0"
  exit 1
fi

export BAO_ADDR BAO_TOKEN AUTH_FILE CADDY_IMAGE

python3 - <<'PY'
import json
import os
import subprocess
import urllib.error
import urllib.request
from pathlib import Path

bao_addr = os.environ["BAO_ADDR"]
bao_token = os.environ["BAO_TOKEN"]
auth_file = Path(os.environ["AUTH_FILE"])
caddy_image = os.environ["CADDY_IMAGE"]


def bao_read(mount: str, path: str) -> dict:
    req = urllib.request.Request(
        f"{bao_addr}/v1/{mount}/data/{path}",
        headers={"X-Vault-Token": bao_token},
    )
    try:
        with urllib.request.urlopen(req) as resp:
            payload = json.load(resp)
    except urllib.error.HTTPError as exc:
        if exc.code == 503:
            raise SystemExit(f"ERROR: OpenBao at {bao_addr} returned 503 (sealed?).") from exc
        if exc.code == 403:
            raise SystemExit(f"ERROR: OpenBao returned 403 for {mount}/{path}.") from exc
        if exc.code == 404:
            raise SystemExit(
                f"ERROR: OpenBao returned 404 for {mount}/{path}.\n"
                f"  Create {{ caddy_openbao_mount }}/{{ caddy_www_openbao_path }} with:\n"
                f"    gateway_username, gateway_password"
            ) from exc
        raise SystemExit(f"ERROR: failed to read {mount}/{path}: {exc}") from exc
    data = payload.get("data", {}).get("data", {})
    if not data:
        raise SystemExit(f"ERROR: {mount}/{path} is empty")
    return data


def pick(data: dict, *keys: str) -> str:
    for key in keys:
        value = data.get(key)
        if value is not None and str(value).strip():
            return str(value)
    raise SystemExit(f"ERROR: none of {keys} found in {data}")


app = bao_read("{{ caddy_openbao_mount }}", "{{ caddy_www_openbao_path }}")
username = pick(app, "gateway_username", "basicauth_username", "username")
password = pick(app, "gateway_password", "basicauth_password", "password")

result = subprocess.run(
    ["docker", "run", "--rm", caddy_image, "caddy", "hash-password", "--plaintext", password],
    check=True,
    capture_output=True,
    text=True,
)
password_hash = result.stdout.strip()
if not password_hash.startswith("$2"):
    raise SystemExit(f"ERROR: unexpected hash from caddy hash-password: {password_hash[:20]}...")

auth_file.parent.mkdir(parents=True, exist_ok=True)
content = (
    "# Generated by sync-www-gateway-auth-from-openbao.sh — do not edit\n"
    "(www_gateway_auth) {\n"
    "    basicauth {\n"
    f"        {username} {password_hash}\n"
    "    }\n"
    "}\n"
)
tmp = auth_file.with_suffix(".tmp")
tmp.write_text(content, encoding="utf-8")
tmp.replace(auth_file)
auth_file.chmod(0o600)

print(f"Wrote Caddy basic-auth snippet for www.ittd.app → {auth_file}")
print(f"  OpenBao: {{ caddy_openbao_mount }}/{{ caddy_www_openbao_path }} → gateway_username")
print("  Restart Caddy: docker compose -f /opt/cvforge/gateway/docker-compose.yml restart caddy")
PY
