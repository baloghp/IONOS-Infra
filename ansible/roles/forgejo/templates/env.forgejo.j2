# Ansible-managed skeleton — apply secrets with sync-forgejo-from-openbao.sh
USER_UID=1000
USER_GID=1000

FORGEJO__server__DOMAIN={{ forgejo_domain }}
FORGEJO__server__ROOT_URL={{ forgejo_public_url }}/
FORGEJO__server__HTTP_ADDR={{ forgejo_wg_bind }}
FORGEJO__server__HTTP_PORT={{ forgejo_port }}
FORGEJO__server__PROTOCOL=http
FORGEJO__server__DISABLE_SSH=true
FORGEJO__server__START_SSH_SERVER=false
FORGEJO__server__LANDING_PAGE=explore

FORGEJO__database__DB_TYPE=postgres
# Forgejo Docker expects host:port in HOST (PORT alone is ignored by install wizard)
FORGEJO__database__HOST={{ forgejo_postgres_host }}:{{ forgejo_postgres_port }}
FORGEJO__database__NAME={{ forgejo_postgres_db }}
FORGEJO__database__USER={{ forgejo_postgres_user }}
FORGEJO__database__PASSWD=REPLACE_AFTER_OPENBAO

FORGEJO__security__SECRET_KEY=REPLACE_AFTER_OPENBAO
FORGEJO__security__INSTALL_LOCK=false

FORGEJO_ADMIN_USER={{ forgejo_admin_username }}
FORGEJO_ADMIN_PASSWORD=REPLACE_AFTER_OPENBAO
FORGEJO_ADMIN_EMAIL={{ forgejo_admin_email }}
