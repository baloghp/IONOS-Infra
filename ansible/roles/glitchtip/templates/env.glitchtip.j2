# Ansible-managed — non-secret GlitchTip config only.
# Secrets written by sync-glitchtip-from-openbao.sh (no placeholders).

PORT={{ glitchtip_port }}
GLITCHTIP_DOMAIN={{ glitchtip_public_url }}
CSRF_TRUSTED_ORIGINS={{ glitchtip_public_url }}
ALLOWED_HOSTS={{ glitchtip_domain }},{{ glitchtip_wg_bind }}

# Postgres-backed cache/queue (no Valkey on Infra)
VALKEY_URL={{ glitchtip_valkey_url }}

DEFAULT_FROM_EMAIL={{ glitchtip_default_from_email }}
ENABLE_USER_REGISTRATION=false
ENABLE_ORGANIZATION_CREATION=true
GLITCHTIP_MAX_EVENT_LIFE_DAYS=90
CELERY_WORKER_AUTOSCALE=1,2
CELERY_WORKER_MAX_TASKS_PER_CHILD=10000
