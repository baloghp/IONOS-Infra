# Ansible-managed — LiteLLM (external Postgres + Valkey, WireGuard bind)
services:
  litellm:
    image: {{ litellm_image }}
    container_name: litellm
    restart: unless-stopped
    network_mode: host
    env_file:
      - .env
    volumes:
      - ./config.yaml:/app/config.yaml:ro
    command: ["--config", "/app/config.yaml", "--port", "{{ litellm_port }}"]
    healthcheck:
      # The proxy image has no wget. Python raises on a non-200, so the probe exits non-zero.
      test:
        [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://{{ litellm_wg_bind }}:{{ litellm_port }}/health/liveliness')",
        ]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 120s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
