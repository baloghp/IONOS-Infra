# Ansible-managed — n8n (external Infra Postgres, host network)
services:
  n8n:
    image: {{ n8n_image }}
    container_name: n8n
    restart: unless-stopped
    network_mode: host
    env_file:
      - {{ n8n_env_file }}
    volumes:
      - ./data:/home/node/.n8n
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://{{ n8n_wg_bind }}:{{ n8n_port }}/healthz || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 90s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
