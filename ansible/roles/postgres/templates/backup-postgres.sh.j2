#!/usr/bin/env bash
# Ansible-managed — daily Postgres backup via docker exec
set -euo pipefail

CONTAINER="{{ postgres_backup_container }}"
HOST="{{ postgres_backup_host }}"
PORT="{{ postgres_backup_port }}"
BACKUP_DIR="{{ postgres_backup_dir }}"
RETENTION_DAYS="{{ postgres_backup_retention_days }}"
ENV_FILE="{{ postgres_backup_env_file }}"

set -a
# shellcheck source=/dev/null
source "$ENV_FILE"
set +a

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
INSTANCE="{{ postgres_backup_instance }}"
OUT="${BACKUP_DIR}/${INSTANCE}-${STAMP}.sql.gz"

mkdir -p "$BACKUP_DIR"
docker exec -e PGPASSWORD="$POSTGRES_PASSWORD" "$CONTAINER" \
  pg_dump -h "$HOST" -p "$PORT" -U "$POSTGRES_USER" --clean --if-exists | gzip -9 > "$OUT"
find "$BACKUP_DIR" -name "${INSTANCE}-*.sql.gz" -mtime +"$RETENTION_DAYS" -delete
echo "Backup written: $OUT"
