# Ansible-managed — Production Postgres (localhost only, port {{ postgres_prod_port }})
services:
  postgres-prod:
    image: {{ postgres_image }}
    container_name: postgres-prod
    restart: unless-stopped
    network_mode: host
    env_file:
      - .env
    volumes:
      - ./data:/var/lib/postgresql/data
      - ./init:/docker-entrypoint-initdb.d:ro
      - ./backups:/backups
    command:
      - postgres
      - -c
      - listen_addresses={{ postgres_bind_local }},{{ postgres_bind_docker }}
      - -c
      - port={{ postgres_prod_port }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h {{ postgres_bind_local }} -p {{ postgres_prod_port }} -U {{ postgres_superuser }}"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
