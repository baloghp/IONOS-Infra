#!/usr/bin/env bash
# Run MANUALLY on Backend — pushes Postgres credentials to OpenBao over WireGuard.
set -euo pipefail

BAO_ADDR="${BAO_ADDR:-http://{{ wireguard_hosts['ts-ionos-infra'].wg_ip }}:8200}"

if [[ -z "${BAO_TOKEN:-}" ]]; then
  echo "ERROR: export BAO_TOKEN=<token> then: sudo -E $0"
  exit 1
fi

bao_kv_put() {
  local mount="$1"
  local path="$2"
  shift 2
  local json="{"
  local first=true
  for pair in "$@"; do
    local key="${pair%%=*}"
    local value="${pair#*=}"
    if [[ "$first" == true ]]; then first=false; else json+=","; fi
    json+="\"${key}\":\"${value}\""
  done
  json+="}"
  curl -fsS -H "X-Vault-Token: ${BAO_TOKEN}" \
    -X POST "${BAO_ADDR}/v1/${mount}/data/${path}" \
    -d "{\"data\":${json}}"
  echo ""
}

echo "BAO_ADDR=${BAO_ADDR}"
echo "=== Production Postgres ({{ postgres_bind_local }}:{{ postgres_prod_port }}) ==="
bao_kv_put prod postgres \
  host="{{ postgres_bind_local }}" port="{{ postgres_prod_port }}" \
  superuser="{{ postgres_superuser }}" superuser_password="{{ postgres_prod_super_password }}"

{% for db in postgres_prod_databases %}
bao_kv_put prod "postgres/{{ db.name }}" \
  database="{{ db.name }}" username="{{ db.user }}" \
  password="{{ postgres_prod_db_passwords[db.user] }}" \
  host="{{ postgres_bind_local }}" port="{{ postgres_prod_port }}"
{% endfor %}

echo "=== Infra Postgres ({{ postgres_wg_bind }}:{{ postgres_infra_port }}) ==="
bao_kv_put infra postgres \
  host="{{ postgres_wg_bind }}" port="{{ postgres_infra_port }}" \
  superuser="{{ postgres_superuser }}" superuser_password="{{ postgres_infra_super_password }}"

{% for db in postgres_infra_databases %}
bao_kv_put infra "postgres/{{ db.name }}" \
  database="{{ db.name }}" username="{{ db.user }}" \
  password="{{ postgres_infra_db_passwords[db.user] }}" \
  host="{{ postgres_wg_bind }}" port="{{ postgres_infra_port }}"
{% endfor %}

echo "Done. Verify in OpenBao UI: prod/postgres/, infra/postgres/"
