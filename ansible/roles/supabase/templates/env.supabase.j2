# Ansible-managed skeleton — apply secrets with sync-supabase-from-openbao.sh
POSTGRES_HOST={{ supabase_postgres_host }}
POSTGRES_PORT={{ supabase_postgres_port }}
POSTGRES_DB={{ supabase_postgres_db }}
POSTGRES_PASSWORD=REPLACE_AFTER_OPENBAO

JWT_SECRET=REPLACE_AFTER_OPENBAO
JWT_EXPIRY=3600
ANON_KEY=REPLACE_AFTER_OPENBAO
SERVICE_ROLE_KEY=REPLACE_AFTER_OPENBAO

DASHBOARD_USERNAME=REPLACE_AFTER_OPENBAO
DASHBOARD_PASSWORD=REPLACE_AFTER_OPENBAO

SECRET_KEY_BASE=REPLACE_AFTER_OPENBAO
PG_META_CRYPTO_KEY=REPLACE_AFTER_OPENBAO
LOGFLARE_PUBLIC_ACCESS_TOKEN=REPLACE_AFTER_OPENBAO
LOGFLARE_PRIVATE_ACCESS_TOKEN=REPLACE_AFTER_OPENBAO

SUPABASE_PUBLIC_URL=REPLACE_AFTER_OPENBAO
API_EXTERNAL_URL=REPLACE_AFTER_OPENBAO
SITE_URL=REPLACE_AFTER_OPENBAO
ADDITIONAL_REDIRECT_URLS=

STUDIO_DEFAULT_ORGANIZATION=ITTD
STUDIO_DEFAULT_PROJECT=CVForge

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

SMTP_ADMIN_EMAIL=REPLACE_AFTER_OPENBAO
SMTP_HOST=REPLACE_AFTER_OPENBAO
SMTP_PORT=REPLACE_AFTER_OPENBAO
SMTP_USER=REPLACE_AFTER_OPENBAO
SMTP_PASS=REPLACE_AFTER_OPENBAO
SMTP_SENDER_NAME=REPLACE_AFTER_OPENBAO
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

PGRST_DB_SCHEMAS=public,storage,graphql_public
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=stub
IMGPROXY_AUTO_WEBP=true
