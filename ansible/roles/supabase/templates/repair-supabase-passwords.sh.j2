#!/usr/bin/env bash
# Align Supabase internal DB role passwords with POSTGRES_PASSWORD in .env
set -euo pipefail

ENV_FILE="{{ supabase_project_dir }}/.env"
ROLES_SQL="{{ supabase_project_dir }}/volumes/db/roles.sql"
BAO_ADDR="${BAO_ADDR:-http://{{ wireguard_hosts['ts-ionos-infra'].wg_ip }}:8200}"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "ERROR: ${ENV_FILE} missing"
  exit 1
fi

if [[ -z "${BAO_TOKEN:-}" ]]; then
  echo "ERROR: export BAO_TOKEN=<token> then: sudo -E $0"
  exit 1
fi

read_env_var() {
  local key="$1" line value
  line=$(grep -E "^${key}=" "$ENV_FILE" | tail -1) || true
  [[ -n "$line" ]] || { echo "ERROR: ${key} missing in ${ENV_FILE}" >&2; exit 1; }
  value="${line#*=}"
  value="${value%\"}"
  value="${value#\"}"
  printf '%s' "$value"
}

POSTGRES_PASSWORD="$(read_env_var POSTGRES_PASSWORD)"
pg_json=$(curl -fsS -H "X-Vault-Token: ${BAO_TOKEN}" "${BAO_ADDR}/v1/prod/data/postgres")
pg_super_pass=$(echo "$pg_json" | jq -r '.data.data.superuser_password')

echo "Resetting Supabase internal role passwords to match .env..."
docker run --rm \
  --network host \
  -e POSTGRES_PASSWORD="${POSTGRES_PASSWORD}" \
  -e PGPASSWORD="${pg_super_pass}" \
  postgres:16-alpine \
  psql -h 127.0.0.1 -p {{ supabase_postgres_port }} -U postgres -d {{ supabase_postgres_db }} \
    -v ON_ERROR_STOP=1 -c "
      DO \$\$
      DECLARE r text;
      BEGIN
        FOREACH r IN ARRAY ARRAY[
          'supabase_auth_admin',
          'authenticator',
          'supabase_storage_admin'
        ] LOOP
          IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = r) THEN
            EXECUTE format('ALTER USER %I WITH PASSWORD %L', r, '${POSTGRES_PASSWORD}');
          END IF;
        END LOOP;
      END
      \$\$;"

echo "Done. Restart auth and storage:"
echo "  docker compose -f {{ supabase_project_dir }}/{{ supabase_compose_file }} restart auth storage"
