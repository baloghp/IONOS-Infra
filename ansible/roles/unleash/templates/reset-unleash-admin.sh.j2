#!/usr/bin/env bash
# Reset Unleash admin so UNLEASH_DEFAULT_ADMIN_PASSWORD from .env is applied on next start.
# Use when Unleash first started before bootstrap (admin locked to wrong password).
set -euo pipefail

ENV_FILE="{{ unleash_project_dir }}/.env"
COMPOSE_FILE="{{ unleash_project_dir }}/{{ unleash_compose_file }}"
PORT="{{ unleash_port }}"
ADMIN_USER="{{ unleash_admin_username }}"

psql_run() {
  docker run --rm --network host postgres:16-alpine \
    psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -c "$1"
}

if [[ ! -f "$ENV_FILE" ]]; then
  echo "ERROR: ${ENV_FILE} missing — run ansible-playbook playbooks/backend-services.yml first"
  exit 1
fi

if grep -q 'REPLACE_AFTER_BOOTSTRAP' "$ENV_FILE"; then
  echo "ERROR: Admin password not configured — run first:"
  echo "  export BAO_TOKEN=<token>"
  echo "  sudo -E {{ unleash_credentials_dir }}/bootstrap-unleash.sh"
  exit 1
fi

DATABASE_URL=$(grep '^DATABASE_URL=' "$ENV_FILE" | cut -d= -f2-)

echo "Stopping Unleash..."
docker compose -f "$COMPOSE_FILE" down

echo "Removing existing admin user from database..."
psql_run "DELETE FROM role_user WHERE user_id IN (SELECT id FROM users WHERE username = '${ADMIN_USER}');"
psql_run "DELETE FROM personal_access_tokens WHERE user_id IN (SELECT id FROM users WHERE username = '${ADMIN_USER}');"
psql_run "DELETE FROM reset_tokens WHERE user_id IN (SELECT id FROM users WHERE username = '${ADMIN_USER}');"
psql_run "DELETE FROM favorite_features WHERE user_id IN (SELECT id FROM users WHERE username = '${ADMIN_USER}');"
psql_run "DELETE FROM favorite_projects WHERE user_id IN (SELECT id FROM users WHERE username = '${ADMIN_USER}');"
psql_run "DELETE FROM user_notifications WHERE user_id IN (SELECT id FROM users WHERE username = '${ADMIN_USER}');"
deleted=$(docker run --rm --network host postgres:16-alpine \
  psql "$DATABASE_URL" -tAc "DELETE FROM users WHERE username = '${ADMIN_USER}' RETURNING id;")
deleted=$(echo "$deleted" | tr -d '[:space:]')

if [[ -z "$deleted" ]]; then
  echo "WARNING: no '${ADMIN_USER}' user row deleted (may already be absent)"
fi

echo "Starting Unleash..."
docker compose -f "$COMPOSE_FILE" up -d

echo "Waiting for Unleash health..."
for _ in $(seq 1 30); do
  if wget -qO- "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
    break
  fi
  sleep 2
done

if ! wget -qO- "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
  echo "WARNING: health check timed out — check: docker logs unleash"
  exit 1
fi

echo "Waiting for admin user recreation..."
for _ in $(seq 1 15); do
  count=$(docker run --rm --network host postgres:16-alpine \
    psql "$DATABASE_URL" -tAc "SELECT count(*) FROM users WHERE username = '${ADMIN_USER}';")
  count=$(echo "$count" | tr -d '[:space:]')
  if [[ "$count" == "1" ]]; then
    break
  fi
  docker compose -f "$COMPOSE_FILE" restart unleash >/dev/null
  sleep 4
done

echo "Verifying admin login..."
python3 - <<'PY'
import json
import sys
import urllib.error
import urllib.request
from pathlib import Path

env = Path("{{ unleash_project_dir }}/.env").read_text().splitlines()
vals = dict(line.split("=", 1) for line in env if "=" in line and not line.startswith("#"))
body = json.dumps({
    "username": vals["UNLEASH_DEFAULT_ADMIN_USERNAME"],
    "password": vals["UNLEASH_DEFAULT_ADMIN_PASSWORD"],
}).encode()
req = urllib.request.Request(
    "http://127.0.0.1:{{ unleash_port }}/auth/simple/login",
    data=body,
    headers={"Content-Type": "application/json"},
    method="POST",
)
try:
    with urllib.request.urlopen(req) as resp:
        print(f"OK — login works for user '{vals['UNLEASH_DEFAULT_ADMIN_USERNAME']}' (HTTP {resp.status}).")
        print("Open: https://flags.ittd.app")
        print("Password: OpenBao prod/unleash → admin")
        sys.exit(0)
except urllib.error.HTTPError as exc:
    print(f"ERROR: login returned HTTP {exc.code} after reset.", file=sys.stderr)
    print("Re-run bootstrap-unleash.sh if .env password differs from OpenBao.", file=sys.stderr)
    sys.exit(1)
PY
