# Ansible-managed — Valkey (localhost only, port {{ valkey_port }})
services:
  valkey:
    image: {{ valkey_image }}
    container_name: valkey
    restart: unless-stopped
    network_mode: host
    env_file:
      - .env
    volumes:
      - ./data:/data
    command:
      - valkey-server
      - --bind
      - {{ valkey_bind_address }}
      - --port
      - "{{ valkey_port }}"
      - --requirepass
      - ${VALKEY_PASSWORD}
      - --appendonly
      - "yes"
      - --dir
      - /data
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli -h {{ valkey_bind_address }} -p {{ valkey_port }} -a \"$$VALKEY_PASSWORD\" ping | grep -q PONG"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
