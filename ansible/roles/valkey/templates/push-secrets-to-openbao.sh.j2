#!/usr/bin/env bash
# Run MANUALLY on Backend — pushes Valkey credentials to OpenBao over WireGuard.
set -euo pipefail

BAO_ADDR="${BAO_ADDR:-http://{{ wireguard_hosts['ts-ionos-infra'].wg_ip }}:8200}"

if [[ -z "${BAO_TOKEN:-}" ]]; then
  echo "ERROR: export BAO_TOKEN=<token> then: sudo -E $0"
  exit 1
fi

curl -fsS -H "X-Vault-Token: ${BAO_TOKEN}" \
  -X POST "${BAO_ADDR}/v1/prod/data/valkey" \
  -d '{"data":{"host":"{{ valkey_bind_address }}","port":"{{ valkey_port }}","password":"{{ valkey_password }}"}}'
echo ""
echo "Done. Verify in OpenBao UI: prod/valkey"
