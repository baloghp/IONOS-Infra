# Ansible-managed — non-secret Woodpecker config only.
# Secrets are written by sync-woodpecker-from-openbao.sh (never use placeholders here).

WOODPECKER_OPEN=false
WOODPECKER_HOST={{ woodpecker_public_url }}
WOODPECKER_SERVER_ADDR={{ woodpecker_wg_bind }}:{{ woodpecker_http_port }}
WOODPECKER_GRPC_ADDR={{ woodpecker_wg_bind }}:{{ woodpecker_grpc_port }}

WOODPECKER_FORGEJO=true
WOODPECKER_FORGEJO_URL={{ woodpecker_forgejo_url }}

WOODPECKER_ADMIN={{ woodpecker_admin_users }}
WOODPECKER_DISABLE_USER_REGISTRATION=true
WOODPECKER_AUTHENTICATE_PUBLIC_REPOS=false

WOODPECKER_DATABASE_DRIVER=postgres

WOODPECKER_LOG_LEVEL=info
WOODPECKER_LOG_STORE=database

# Agent (same .env file; sync adds shared secret + server address)
WOODPECKER_BACKEND=docker
WOODPECKER_SERVER={{ woodpecker_wg_bind }}:{{ woodpecker_grpc_port }}
WOODPECKER_MAX_WORKFLOWS={{ woodpecker_agent_max_workflows }}
# Host network: Forgejo binds 10.44.0.3:3000 — disable agent healthcheck port
WOODPECKER_HEALTHCHECK=false
